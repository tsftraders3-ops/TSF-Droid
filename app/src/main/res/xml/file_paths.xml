<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.6: share paths for agent-created artifact cards (HTML/PDF files
     written into the workspace). Exposes only the app's own external and
     internal file dirs under a path-scoped grant — never the whole device. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path
        name="workspace_external"
        path="workspace/" />
    <files-path
        name="workspace_internal"
        path="workspace/" />
    <external-files-path
        name="external_files_root"
        path="." />
    <files-path
        name="internal_files_root"
        path="." />
    <!-- v1.0.6: cache-export fallback — a file that somehow resolves outside
         the roots above is copied here before the Open/Share grant, so the
         card can never fail just because the path moved. -->
    <cache-path
        name="exports"
        path="exports/" />
</paths>
